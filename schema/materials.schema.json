{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmalova.com/schema/materials.schema.json",
  "title": "Материалы цифрового приложения",
  "description": "Schema v2 для Этапа 2: совместима с текущими материалами и поддерживает поиск по задачам, аудиториям и темам книги.",
  "type": "object",
  "required": [
    "materials",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "updated",
        "year"
      ],
      "additionalProperties": true,
      "properties": {
        "newLast30": {
          "type": "integer",
          "minimum": 0,
          "description": "Legacy-поле. В дальнейшем рассчитывается только по подтвержденным publishedAt."
        },
        "updated": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy-подпись. Не использовать как замену подтвержденной дате материала."
        },
        "updatesQuarter": {
          "type": "string",
          "description": "Legacy-поле. Не заполнять вымышленными значениями."
        },
        "year": {
          "type": [
            "string",
            "integer"
          ]
        },
        "spark": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Legacy-поле. Не использовать как неподтвержденную аналитику."
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "route",
          "title",
          "type",
          "page",
          "link",
          "status",
          "level"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "not": {
              "required": [
                "publishedAt",
                "published_at"
              ]
            }
          },
          {
            "not": {
              "required": [
                "updatedAt",
                "updated_at"
              ]
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^m\\d{3,}$"
          },
          "route": {
            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "desc": {
            "type": "string"
          },
          "type": {
            "enum": [
              "гайд",
              "видео",
              "статья",
              "кейс",
              "обзор",
              "методика",
              "сообщество",
              "чек-лист",
              "подкаст"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "link": {
            "type": "string",
            "pattern": "^https://mmalova\\.com/"
          },
          "status": {
            "enum": [
              "",
              "доступно",
              "новое",
              "обновлено",
              "скоро"
            ],
            "description": "Значения «новое» и «обновлено» сохранены временно для совместимости. В новой модели свежесть рассчитывается по датам."
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "expert": {
            "type": "boolean"
          },
          "expert_name": {
            "type": "string",
            "minLength": 2
          },
          "publishedAt": {
            "type": "string",
            "format": "date",
            "description": "Каноническая дата публикации в формате YYYY-MM-DD."
          },
          "updatedAt": {
            "type": "string",
            "format": "date",
            "description": "Каноническая дата реального обновления в формате YYYY-MM-DD."
          },
          "changeSummary": {
            "type": "string",
            "minLength": 3,
            "description": "Краткое описание фактически внесенного изменения."
          },
          "shareQuoteId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "description": "Идентификатор цитаты готового сервиса «Цитатник»."
          },
          "bookTheme": {
            "type": "string",
            "enum": [
              "доверие",
              "стратегия",
              "кризис",
              "управление",
              "профессия",
              "ии и технологии",
              "человекоцентричность",
              "сообщество"
            ]
          },
          "audiences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^A-ZА-ЯЁ]*$"
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^A-ZА-ЯЁ]*$"
            },
            "uniqueItems": true
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^A-ZА-ЯЁ]*$"
            },
            "uniqueItems": true
          },
          "published_at": {
            "type": "string",
            "format": "date",
            "deprecated": true,
            "description": "Legacy-поле. Временно принимается; заменить на publishedAt."
          },
          "updated_at": {
            "type": "string",
            "format": "date",
            "deprecated": true,
            "description": "Legacy-поле. Временно принимается; заменить на updatedAt."
          },
          "parent_id": {
            "type": "string",
            "pattern": "^m\\d{3,}$"
          },
          "anchor": {
            "type": "string",
            "pattern": "^#?[A-Za-zА-Яа-яЁё0-9_-]+$"
          }
        }
      }
    }
  }
}
